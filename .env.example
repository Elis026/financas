# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o Git.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, ex.: CSRF_TRUSTED_ORIGINS=https://seuusuario.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# PostgreSQL. Deixe DB_NAME vazio para usar SQLite (arquivo db.sqlite3).
DB_NAME=financas
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
